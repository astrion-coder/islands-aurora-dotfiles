# Generated by matugen from the current wallpaper — do not edit.
# Template: ~/.config/matugen/templates/dunstrc
# Notifications styled like the bar's islands: frosted glass (blurred by the
# "blur-notifications" layer rule in hyprland.lua), rounded, no hard border.

[global]
    follow = mouse
    origin = top-right
    offset = (12, 8)             # below the bar (dunst already clears its space), in line with the window gaps
    width = (280, 380)
    height = (0, 220)
    notification_limit = 5
    gap_size = 8
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 14
    corner_radius = 16
    frame_width = 0
    separator_height = 0
    separator_color = frame

    font = Noto Sans 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 60
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_theme = breeze-dark
    enable_recursive_icon_lookup = true

    progress_bar = true
    progress_bar_height = 6
    progress_bar_corner_radius = 3
    progress_bar_frame_width = 0
    highlight = "{{colors.primary.default.hex}}"

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "{{colors.surface.default.hex}}a6"
    foreground = "{{colors.on_surface_variant.default.hex}}"
    frame_color = "{{colors.outline_variant.default.hex}}"
    timeout = 5

[urgency_normal]
    background = "{{colors.surface.default.hex}}a6"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.primary.default.hex}}"
    timeout = 8

[urgency_critical]
    background = "{{colors.error_container.default.hex}}d9"
    foreground = "{{colors.on_error_container.default.hex}}"
    frame_color = "{{colors.error.default.hex}}"
    highlight = "{{colors.error.default.hex}}"
    timeout = 0
