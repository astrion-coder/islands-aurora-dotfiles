/* Generated by matugen from the current wallpaper — do not edit.
 * Template: ~/.config/matugen/templates/rofi-colors.rasi */
* {
    fg:        {{colors.on_surface.default.hex}};
    subtle:    {{colors.on_surface_variant.default.hex}};
    muted:     {{colors.outline.default.hex}};
    accent:    {{colors.primary.default.hex}};
    accent2:   {{colors.tertiary.default.hex}};
    ink:       {{colors.on_primary.default.hex}};
    error:     {{colors.error.default.hex}};

    /* glass, like the bar's islands (base = surface + alpha) */
    glass:        {{colors.surface.default.hex}}8c;
    glass-light:  {{colors.on_surface.default.hex}}14;
    selected:     {{colors.primary.default.hex}}33;

    /* matched characters while typing: accent2, bold */
    match:        bold {{colors.tertiary.default.hex}};
}
