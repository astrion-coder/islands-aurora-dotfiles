# Generated by matugen from the current wallpaper — do not edit.
# Template: ~/.config/matugen/templates/zathurarc
# Pages: transparent paper + palette text, so the frosted window (Hyprland blur)
# shows through; images keep their hues. Window background 65% like Qt/GTK apps.

set font                   "DroidSansM Nerd Font 10"
set selection-clipboard    clipboard
set adjust-open            width
set guioptions             ""

# pages
set recolor                true
set recolor-keephue        true
set recolor-lightcolor     "rgba(0,0,0,0)"
set recolor-darkcolor      "{{colors.on_surface.default.hex}}"

# window
set default-bg             "rgba({{colors.surface.default.red}},{{colors.surface.default.green}},{{colors.surface.default.blue}},0.65)"
set default-fg             "{{colors.on_surface.default.hex}}"

# status / command bar
set statusbar-bg           "rgba({{colors.surface_container.default.red}},{{colors.surface_container.default.green}},{{colors.surface_container.default.blue}},0.85)"
set statusbar-fg           "{{colors.on_surface.default.hex}}"
set inputbar-bg            "rgba({{colors.surface_container.default.red}},{{colors.surface_container.default.green}},{{colors.surface_container.default.blue}},0.85)"
set inputbar-fg            "{{colors.on_surface.default.hex}}"
set notification-bg        "{{colors.surface_container_high.default.hex}}"
set notification-fg        "{{colors.on_surface.default.hex}}"
set notification-error-bg  "{{colors.error_container.default.hex}}"
set notification-error-fg  "{{colors.on_error_container.default.hex}}"
set notification-warning-bg "{{colors.tertiary_container.default.hex}}"
set notification-warning-fg "{{colors.on_tertiary_container.default.hex}}"
set completion-bg          "{{colors.surface_container.default.hex}}"
set completion-fg          "{{colors.on_surface.default.hex}}"
set completion-highlight-bg "{{colors.primary.default.hex}}"
set completion-highlight-fg "{{colors.on_primary.default.hex}}"
set completion-group-bg    "{{colors.surface_container_high.default.hex}}"
set completion-group-fg    "{{colors.primary.default.hex}}"

# search matches / selection
set highlight-color        "rgba({{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}},0.35)"
set highlight-active-color "rgba({{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}},0.5)"
set index-bg               "rgba({{colors.surface.default.red}},{{colors.surface.default.green}},{{colors.surface.default.blue}},0.65)"
set index-fg               "{{colors.on_surface.default.hex}}"
set index-active-bg        "{{colors.primary.default.hex}}"
set index-active-fg        "{{colors.on_primary.default.hex}}"

# Shift+O: open this PDF in Okular (for highlighting; zathura can't annotate)
map O feedkeys ":exec okular '$FILE'<Return>"
