/* Islands Aurora for rofi: a frosted panel like the bar's islands.
 * Colours come from colors.rasi (matugen, follows the wallpaper). No glows, borders
 * or sheen. Hyprland blurs behind it (layer rule "blur-rofi" in hyprland.lua). */

@import "colors.rasi"

* {
    font:             "DroidSansM Nerd Font Bold 11";
    background-color: transparent;
    text-color:       @fg;
    spacing:          0;
}

window {
    width:            640px;
    location:         center;
    anchor:           center;
    y-offset:         -80px;
    border-radius:    20px;
    background-color: @glass;
    padding:          14px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, message, listview ];   /* one menu, no tabs */
}

/* ---------- search pill ---------- */
inputbar {
    background-color: @glass-light;
    border-radius:    999px;
    padding:          10px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}
prompt {
    text-color: @accent;
}
entry {
    placeholder:       "search…";
    placeholder-color: @muted;
    cursor:            text;
}

message {
    background-color: @glass-light;
    border-radius:    12px;
    padding:          8px 14px;
}
textbox {
    text-color: @subtle;
}

/* ---------- results ---------- */
listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      4px;
    cycle:        true;
}
element {
    padding:       8px 12px;
    border-radius: 12px;
    spacing:       12px;
    cursor:        pointer;
}
element normal.normal, element alternate.normal {
    background-color: transparent;
}
element selected.normal {
    background-color: @selected;
}
element normal.urgent, element alternate.urgent, element selected.urgent {
    text-color: @error;
}
element normal.active, element alternate.active {
    text-color: @accent;
}
element-icon {
    size:            22px;
    vertical-align:  0.5;
    cursor:          inherit;
}
element-text {
    vertical-align: 0.5;
    highlight:      @match;       /* typed-match colour, from colors.rasi */
    cursor:         inherit;
}
element-text selected {
    text-color: @fg;
}

/* ---------- mode tabs (unused: one menu with sub-menus) ---------- */
mode-switcher {
    spacing: 6px;
}
button {
    padding:          7px 0;
    border-radius:    999px;
    background-color: @glass-light;
    text-color:       @muted;
    cursor:           pointer;
}
button selected {
    background-color: @selected;
    text-color:       @accent;
}
