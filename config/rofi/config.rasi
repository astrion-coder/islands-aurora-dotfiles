/* rofi as a Raycast-style hub: scripts/launch.sh opens one main menu (apps +
 * commands from scripts/commands.sh); commands open sub-menus. Shared settings here. */
configuration {
    show-icons:       true;
    icon-theme:       "breeze-dark";
    drun-display-format: "{name}";
    matching:         "fuzzy";
    sort:             true;
    sorting-method:   "fzf";
    case-sensitive:   false;
    scroll-method:    1;

    display-combi:     "search";
    display-drun:      "apps";
    display-window:    "windows";
    display-clipboard: "clipboard";
    display-emoji:     "emoji";
    display-calc:      "calc";
    display-files:     "files";
    display-system:    "system";

    combi-hide-mode-prefix: true;
}

@theme "~/.config/rofi/theme.rasi"
