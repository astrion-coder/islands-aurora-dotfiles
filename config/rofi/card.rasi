/* Answer card (launch.sh "result"): query on the left, answer on the right, Raycast
 * style. Built on theme.rasi; launch.sh fills the textbox contents per answer. */

@import "theme.rasi"

window {
    width:    760px;
    y-offset: -80px;
}

mainbox {
    spacing:  12px;
    children: [ textbox-title, card ];
}

textbox-title {
    expand:     false;
    padding:    2px 6px;
    text-color: @muted;
    content:    "";
}

card {
    orientation:      horizontal;
    background-color: @glass-light;
    border-radius:    16px;
    padding:          34px 24px;
    spacing:          16px;
    children:         [ side-left, textbox-arrow, side-right ];
}

side-left, side-right {
    orientation: vertical;
    spacing:     16px;   /* value -> caption */
}
side-left  { children: [ textbox-lmain, textbox-lcap ]; }
side-right { children: [ textbox-rmain, textbox-rcap ]; }

textbox-lmain, textbox-rmain {
    font:             "DroidSansM Nerd Font Bold 26";
    horizontal-align: 0.5;
    content:          "";
}
textbox-rmain {
    text-color: @accent;
}
textbox-lcap, textbox-rcap {
    horizontal-align: 0.5;
    text-color:       @muted;
    content:          "";
}

textbox-arrow {
    expand:         false;
    vertical-align: 0.5;
    font:           "DroidSansM Nerd Font Bold 20";
    text-color:     @muted;
    content:        "→";
}
