// -*- mode: jsonc -*-
// "Islands Aurora" layout — each group/* renders as its own floating pill
{
    "layer": "top",
    "position": "top",
    "height": 48,           // 36px islands + 6px room above/below for their shadow
    "margin-top": 4,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 8,           // gap between islands

    "modules-left": [
        "group/workspaces-island",
        "hyprland/window"
    ],
    "modules-center": [
        "clock#date",
        "clock#time"
    ],
    "modules-right": [
        "group/stats",
        "group/status",
        "custom/power"
    ],

    // ---- Islands ----
    "group/workspaces-island": {
        "orientation": "horizontal",
        "modules": ["custom/ws-daemon", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]
    },
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory"]
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": ["tray", "custom/audio", "battery"]
    },

    // ---- Modules ----
    // Workspaces: one custom module per workspace so clicks can use Lua dispatch
    // (built-in hyprland/workspaces clicks are broken on Lua Hyprland, Alexays/Waybar#5008).
    // State comes from scripts/workspaces.py; a module with no text is hidden.
    "custom/ws-daemon": {
        "exec": "$HOME/.config/waybar/scripts/workspaces.py",
        "restart-interval": 2
    },
    "custom/ws1": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/1 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },
    "custom/ws2": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/2 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },
    "custom/ws3": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/3 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
    },
    "custom/ws4": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/4 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
    },
    "custom/ws5": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/5 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
    },
    "custom/ws6": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/6 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"
    },
    "custom/ws7": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/7 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'"
    },
    "custom/ws8": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/8 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'"
    },
    "custom/ws9": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/9 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'"
    },
    "custom/ws10": {
        "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/10 2>/dev/null",
        "return-type": "json", "interval": "once", "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },
    // Date and time: two islands side by side in the middle of the bar
    "clock#date": {
        "format": "{:%a\u2002%d\u2004%b}",   // en space; narrower after the digits (they carry their own side spacing)
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "cpu": {
        "interval": 2,
        "format": "<span fgalpha='55%'>cpu</span>  {usage}%",
        "tooltip": false
    },
    "memory": {
        "interval": 5,
        "format": "<span fgalpha='55%'>mem</span>  {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({percentage}%)"
    },
    // Sound pill: one module (scripts/audio.sh) so icon, volume and tooltip act as one.
    // Speaker or Bluetooth icon by class; tooltip = device name (+ battery for Bluetooth).
    // Right-click: scripts/sound-menu.py (mute, mixer, Bluetooth on/off and devices).
    "custom/audio": {
        "exec": "$HOME/.config/waybar/scripts/audio.sh",
        "return-type": "json",
        "on-click": "$HOME/.config/waybar/scripts/popup.sh org.pulseaudio.pavucontrol pavucontrol",
        "on-click-right": "$HOME/.config/waybar/scripts/sound-menu.py",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "battery": {
        // Waybar sets the lowest matching state as a CSS class -> picks the SVG fill level
        "states": {
            "full": 100,
            "high": 87,
            "half": 62,
            "low": 37,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-alt": "{time}",
        "tooltip-format": "{timeTo}"
    },
    "custom/power": {
        "format": " ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            // Lua Hyprland: dispatches use Lua syntax (plain "dispatch exit" is rejected)
            "lock": "pidof hyprlock || hyprlock",
            "logout": "hyprctl dispatch 'hl.dsp.exit()'",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    },
    "tray": {
        "spacing": 0,         // each icon is its own 34px circle (style.css)
        "icon-size": 15,
        "cursor": true        // hand cursor, like the power button
        // opensnitch-ui's shield comes from scripts/opensnitch-ui.sh (themed tray icons)
    }
}
